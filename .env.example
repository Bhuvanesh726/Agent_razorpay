# NVIDIA_API_KEY is used starting Layer 1 (AI agent). Not read by Layer 0 code.
NVIDIA_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_FALLBACK=openai/gpt-oss-120b

# Layer 2 — Razorpay test-mode credentials. Get these from the Razorpay
# dashboard (Test Mode). Never commit real values here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Layer 0: shopping app ---
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_USER_ID=user_demo
# The one canonical dev frontend origin (CORS, OAuth, post-login redirects).
# Use 127.0.0.1, not localhost — see backend/app/core/config.py.
FRONTEND_URL=http://127.0.0.1:3000

# SQLite for local dev. Swap to Postgres later, e.g.:
# DATABASE_URL=postgresql+psycopg://razorpay:razorpay@localhost:5432/razorpay_agent
DATABASE_URL=sqlite:///./razorpay_agent.db

# --- Layer 4.7: principals ---
# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Documentation only — not read by the app (see app/auth/oauth_router.py).
# Register BOTH http://localhost:8842/api/auth/google/callback AND
# http://127.0.0.1:8842/api/auth/google/callback as Authorized redirect URIs
# on that OAuth client so login works from either host.
GOOGLE_REDIRECT_URI=http://localhost:8842/api/auth/google/callback
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# Comma-separated emails that get the MERCHANT role on first login.
MERCHANT_EMAILS=
