# NVIDIA_API_KEY is used starting Layer 1 (AI agent). Not read by Layer 0 code.
NVIDIA_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_FALLBACK=openai/gpt-oss-120b

# Layer 2 — Razorpay test-mode credentials. Get these from the Razorpay
# dashboard (Test Mode). Never commit real values here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Layer 0: shopping app ---
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_USER_ID=user_demo
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite for local dev. Swap to Postgres later, e.g.:
# DATABASE_URL=postgresql+psycopg://razorpay:razorpay@localhost:5432/razorpay_agent
DATABASE_URL=sqlite:///./razorpay_agent.db
